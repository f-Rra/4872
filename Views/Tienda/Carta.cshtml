@model f4872.ViewModels.CartaVm
@{
    ViewData["Title"] = "La carta";
    Layout = "_Tienda";
}

@* pizzas y focaccias comparten el mismo renglón: se piden igual *@
@functions {
    void Renglones(IReadOnlyList<f4872.ViewModels.RenglonCarta> lista)
    {
        <ol class="carta">
            @foreach (var p in lista)
            {
                <li class="@(p.Activo ? null : "agotada")">
                    <div class="renglon">
                        <p class="nombre">@p.Nombre</p>
                        <i class="puntos"></i>
                        <p class="plata">@(p.Precio?.ToString("C") ?? "—")</p>
                        @if (!p.Activo)
                        {
                            <span class="sello">Se acabó</span>
                        }
                    </div>
                    <div class="abajo">
                        <div class="fila-ing">
                            @for (var i = 0; i < p.Ingredientes.Count; i++)
                            {
                                if (i > 0)
                                {
                                    <span class="sep">·</span>
                                }
                                <span class="ing">@p.Ingredientes[i]</span>
                            }
                        </div>
                    </div>
                </li>
            }
        </ol>
    }
}

<div class="tienda">

    <header class="tapa">
        <img class="logo" src="~/img/logo.png" alt="48·72" width="240" height="240" />
    </header>

    <nav class="solapas" id="solapas" aria-label="Familias">
        <button type="button" data-solapa="pizzas" aria-pressed="true">
            <i class="dib pizza" aria-hidden="true"></i>Pizzas
        </button>
        <button type="button" data-solapa="empanadas" aria-pressed="false">
            <i class="dib empanada" aria-hidden="true"></i>Empanadas
        </button>
        <button type="button" data-solapa="focaccias" aria-pressed="false">
            <i class="dib focaccia" aria-hidden="true"></i>Focaccias
        </button>
    </nav>

    <main class="lista" id="lista">
        <div data-familia="pizzas">@{ Renglones(Model.Pizzas); }</div>
        <div data-familia="empanadas" hidden>
            @if (Model.Packs.Count == 0)
            {
                <p class="vacio">Todavía no hay precios de pack cargados.</p>
            }
            else
            {
                @* el segmentado fija el tamaño: no hay unidades sueltas ni packs
                   mezclados, así que el precio se elige una vez y vale para todos *@
                <div class="tam" id="tam">
                    @foreach (var t in Model.Packs)
                    {
                        var elegido = t.Unidades == Model.Packs[^1].Unidades;
                        <button type="button" data-unidades="@t.Unidades" aria-pressed="@elegido.ToString().ToLowerInvariant()">
                            @* con paréntesis: pegado a la x, Razor lee el @@ como literal *@
                            x@(t.Unidades) · @t.Precio.ToString("C")
                        </button>
                    }
                </div>

                <ol class="gustos">
                    @foreach (var g in Model.Gustos)
                    {
                        <li class="@(g.Activo ? null : "agotada")">
                            <p class="nom">@g.Nombre</p>
                            @if (!g.Activo)
                            {
                                <span class="sello">Se acabó</span>
                            }
                        </li>
                    }
                </ol>
            }
        </div>
        <div data-familia="focaccias" hidden>@{ Renglones(Model.Focaccias); }</div>
    </main>

</div>
