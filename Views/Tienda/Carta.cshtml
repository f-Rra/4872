@model f4872.ViewModels.CartaVm
@* el precio viaja al navegador con punto decimal y sin separadores: lo lee
   parseFloat, que no entiende el formato de es-AR *@
@using System.Globalization
@{
    ViewData["Title"] = "La carta";
    Layout = "_Tienda";
}

@* pizzas y focaccias comparten el mismo renglón: se piden igual *@
@functions {
    void Renglones(IReadOnlyList<f4872.ViewModels.RenglonCarta> lista)
    {
        <ol class="carta">
            @foreach (var p in lista)
            {
                <li class="@(p.Activo ? null : "agotada")" data-base="p@(p.IdProducto)"
                    data-precio="@(p.Precio?.ToString(CultureInfo.InvariantCulture))">
                    <div class="renglon">
                        <p class="nombre">@p.Nombre</p>
                        <i class="puntos"></i>
                        @* cuantas lleva con otra combinacion: va antes del precio para que
                           lo que se achique sea la linea de puntos y no otra cosa *@
                        <span class="otro" hidden></span>
                        <p class="plata">@(p.Precio?.ToString("C") ?? "—")</p>
                        @* el agotado lleva la pastilla en lugar del contador: se ve, pero no se
                           pide. Sin precio tampoco: sumaria cero al total *@
                        @if (p.Activo && p.Precio.HasValue)
                        {
                            <span class="contador cero">
                                <button type="button" data-menos disabled aria-label="Sacar uno">−</button>
                                <span class="n">0</span>
                                <button type="button" data-mas aria-label="Sumar uno">+</button>
                            </span>
                        }
                        else
                        {
                            <span class="sello">Sin stock</span>
                        }
                    </div>
                    <div class="abajo">
                        <div class="fila-ing">
                            @for (var i = 0; i < p.Ingredientes.Count; i++)
                            {
                                if (i > 0)
                                {
                                    <span class="sep">·</span>
                                }
                                var r = p.Ingredientes[i];
                                @* el fijo se ve igual pero no se toca: sin el deja de ser esa pizza *@
                                if (r.Quitable)
                                {
                                    <button type="button" class="ing" data-ing="@r.Clave"
                                            aria-pressed="true" disabled="@(!p.Activo)">@r.Nombre</button>
                                }
                                else
                                {
                                    <button type="button" class="ing fijo" disabled>@r.Nombre</button>
                                }
                            }
                        </div>
                    </div>
                </li>
            }
        </ol>
    }

    // Lo que una familia dice de sí misma, arriba de su lista. Lleva data-familia
    // como la lista: tienda.js esconde y muestra todo lo que lo trae.
    void Ficha(string familia, IReadOnlyList<f4872.ViewModels.DatoFicha> datos, bool oculta)
    {
        if (datos.Count > 0)
        {
            <dl class="ficha" data-familia="@familia" hidden="@oculta">
                @foreach (var d in datos)
                {
                    <div><dt>@d.Rotulo</dt><dd>@d.Valor</dd></div>
                }
            </dl>
        }
    }
}

<div class="tienda dibujando">

    <header class="tapa">
        <img class="logo" src="~/img/logo.png" alt="48·72" width="240" height="240" />
    </header>

    @if (!Model.Abierta)
    {
        @* Cerrada se va la carta entera y también las solapas: llevarían a
           listas que no se pueden pedir. Queda el logo y el cartel. *@
        <main class="lista">
            @* Sin prometer cuándo se vuelve: el día no está guardado en ningún
               lado y una fecha que después no se cumple es peor que no decirla. *@
            <div class="cerrada">
                <h1>La tienda está cerrada</h1>
                <p class="marca">48·72</p>
            </div>
        </main>
    }
    else
    {
        <nav class="solapas" id="solapas" aria-label="Familias">
            <button type="button" data-solapa="pizzas" aria-pressed="true">
                <i class="dib pizza" aria-hidden="true"></i>Pizzas
            </button>
            <button type="button" data-solapa="empanadas" aria-pressed="false">
                <i class="dib empanada" aria-hidden="true"></i>Empanadas
            </button>
            <button type="button" data-solapa="focaccias" aria-pressed="false">
                <i class="dib focaccia" aria-hidden="true"></i>Focaccias
            </button>
        </nav>

        <main class="lista" id="lista">

            @* Lo que cada familia dice de sí misma. Va arriba del cartel y no adentro
               de su lista: el cartel es uno solo y explica los renglones, así que
               tiene que quedar pegado a ellos. Las empanadas no llevan. *@
            @{ Ficha("pizzas", Model.FichaPizzas, false); }
            @{ Ficha("focaccias", Model.FichaFocaccias, true); }

            @* Que los ingredientes se tocan no se descubre solo: la nota del
               diseño decía «probá tocar la muzzarella de la Margarita», y si hay
               que explicárselo al que diseña, el cliente no tiene cómo adivinarlo.

               Va uno solo y afuera de las familias: la carta abre siempre en
               pizzas, así que uno por familia serían dos que nadie ve nunca. Lo
               muestra y lo esconde tienda.js, que además lo saca en empanadas
               —que no tienen nada que sacar—. Sale cada vez que se entra. *@
            <div class="hueco-pista" id="pista" hidden>
                <p class="pista">Tocá un ingrediente para sacarlo.</p>
            </div>

            <div data-familia="pizzas">@{ Renglones(Model.Pizzas); }</div>
            <div data-familia="empanadas" hidden>
                @if (Model.Packs.Count == 0)
                {
                    <p class="vacio">Todavía no hay precios de pack cargados.</p>
                }
                else
                {
                    @* Explica cómo se pide, y por eso va arriba del segmentado, que es
                       lo primero que se toca. Lo muestra tienda.js cada vez que se
                       abre la solapa. *@
                    <div class="hueco-pista" id="pista-packs" hidden>
                        <p class="pista">Cada pack trae 6 o 12 empanadas del mismo gusto. Elegí el tamaño y sumá los que quieras.</p>
                    </div>

                    @* el segmentado fija el tamaño: no hay unidades sueltas ni packs
                       mezclados, así que el precio se elige una vez y vale para todos *@
                    <div class="tam" id="tam">
                        @foreach (var t in Model.Packs)
                        {
                            var elegido = t.Unidades == Model.Packs[^1].Unidades;
                            <button type="button" data-unidades="@t.Unidades"
                                    data-precio="@t.Precio.ToString(CultureInfo.InvariantCulture)"
                                    aria-pressed="@elegido.ToString().ToLowerInvariant()">
                                @* con paréntesis: pegado a la x, Razor lee el @@ como literal *@
                                x@(t.Unidades) · @t.Precio.ToString("C")
                            </button>
                        }
                    </div>

                    <ol class="gustos">
                        @foreach (var g in Model.Gustos)
                        {
                            @* el gusto no lleva la clave escrita: depende del tamaño elegido,
                               así que la pone el navegador cada vez que se pinta *@
                            <li class="@(g.Activo ? null : "agotada")" data-gusto="@g.IdProducto">
                                <p class="nom">@g.Nombre</p>
                                @if (g.Activo)
                                {
                                    <span class="otro" hidden></span>
                                    <span class="contador cero">
                                        <button type="button" data-menos disabled aria-label="Sacar uno">−</button>
                                        <span class="n">0</span>
                                        <button type="button" data-mas aria-label="Sumar uno">+</button>
                                    </span>
                                }
                                else
                                {
                                    <span class="sello">Sin stock</span>
                                }
                            </li>
                        }
                    </ol>
                }
            </div>
            <div data-familia="focaccias" hidden>@{ Renglones(Model.Focaccias); }</div>
        </main>

        @* Arranca en alto cero y crece al sumar algo. No flota por encima de la
           lista: le saca alto, así el último renglón nunca queda tapado *@
        <div class="pedido" id="pedido">
            <span class="cuenta" id="cuenta-n">0 productos</span>
            <b class="cuenta-total" id="cuenta-t">$0</b>
            <a class="ver" asp-action="Checkout">Ver pedido</a>
        </div>
    }

</div>
