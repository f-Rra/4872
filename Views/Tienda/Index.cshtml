@{
    Layout = "_Tienda";
}

<div class="inicio">

    <header class="tapa">
        <img class="logo" src="~/img/logo.png" alt="48·72" width="240" height="240" />
    </header>

    <div class="portada">
        <p class="promesa">Pizzas, Focaccias &amp; Empanadas</p>
    </div>

    <section class="seccion cierre">
        <div class="credenciales">

            <div class="cred">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M7 3h10" /><path d="M7 21h10" />
                    <path d="M7.8 3c0 4 4.2 5.4 4.2 9s-4.2 5-4.2 9" />
                    <path d="M16.2 3c0 4-4.2 5.4-4.2 9s4.2 5 4.2 9" />
                </svg>
                <div><b>Fermentación lenta</b><span>48 a 72 horas en frío.</span></div>
            </div>

            <div class="cred">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 21V9" />
                    <path d="M12 9c0-2 1.6-3.6 3.6-3.6C15.6 7.4 14 9 12 9z" />
                    <path d="M12 9c0-2-1.6-3.6-3.6-3.6C8.4 7.4 10 9 12 9z" />
                    <path d="M12 14c0-2 1.6-3.6 3.6-3.6C15.6 12.4 14 14 12 14z" />
                    <path d="M12 14c0-2-1.6-3.6-3.6-3.6C8.4 12.4 10 14 12 14z" />
                </svg>
                <div><b>Masa madre y harinas seleccionadas</b><span>Sin levadura comercial ni aditivos.</span></div>
            </div>

            <div class="cred">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M3.6 7.6L12 3.4l8.4 4.2v8.8L12 20.6l-8.4-4.2z" />
                    <path d="M3.6 7.6L12 11.8l8.4-4.2" /><path d="M12 11.8v8.8" />
                </svg>
                <div><b>Todo envasado al vacío</b><span>Tu pedido llega sellado y apto para freezar.</span></div>
            </div>

        </div>
    </section>

    <section class="seccion">
        <h2 class="rubro">Cómo funciona 48·72</h2>
        <ol class="recorrido">
            <li>
                <span class="n">1</span>
                <span class="que"><b>Elegís de la carta</b><span>Y sacás lo que no te gusta.</span></span>
            </li>
            <li>
                <span class="n">2</span>
                <span class="que"><b>Dejás tus datos</b><span>Nombre, dirección y WhatsApp.</span></span>
            </li>
            @* la espera no lleva número: no es algo que hace el cliente *@
            <li class="fermenta">
                <span class="n">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                </span>
                <span class="que"><b>48 a 72 horas</b></span>
            </li>
            <li>
                <span class="n">3</span>
                <span class="que"><b>Te escribimos</b><span>Por WhatsApp, para coordinar la entrega.</span></span>
            </li>
            <li>
                <span class="n">4</span>
                <span class="que"><b>Te llevamos tu pedido</b><span>Sin apps de por medio.</span></span>
            </li>
        </ol>
    </section>

    <div class="cta-pie">
        <a class="cta" asp-controller="Tienda" asp-action="Carta">Armá tu pedido</a>
    </div>

</div>
