@{
    Layout = "_Tienda";
}

<div class="inicio">

    <header class="tapa">
        <img class="logo" src="~/img/logo.png" alt="48·72" width="240" height="240" />
    </header>

    <div class="portada">
        <p class="promesa">Pizzas, Focaccias &amp; Empanadas</p>
    </div>

    <section class="seccion cierre">
        <div class="credenciales">

            <div class="cred">
                <i class="dib fermento" aria-hidden="true"></i>
                <div><b>Fermentación lenta</b><span>Entre 48 y 72 hs de reposo en frío.</span></div>
            </div>

            <div class="cred">
                <i class="dib harina" aria-hidden="true"></i>
                <div><b>Masa madre &amp; Harina 00</b><span>La base de nuestros productos.</span></div>
            </div>

            <div class="cred">
                <i class="dib envase" aria-hidden="true"></i>
                <div><b>Envasado al vacío</b><span>Para conservar mejor la calidad de tu pedido.</span></div>
            </div>

            @* Las tres de arriba son del oficio y valen para todo; estas tres
               nombran una familia cada una. La pizza no tenía la suya: las tres
               primeras hablan de su masa, así que era el caso por omisión.

               Reusan los dibujos de las solapas de la carta, que ya estaban. *@
            <div class="cred">
                <i class="dib pizza" aria-hidden="true"></i>
                <div><b>Estilo napoletano</b><span>Borde aireado y masa liviana.</span></div>
            </div>

            <div class="cred">
                <i class="dib focaccia" aria-hidden="true"></i>
                <div><b>Alta hidratación</b><span>Focaccias aireadas en distintos sabores.</span></div>
            </div>

            <div class="cred">
                <i class="dib empanada" aria-hidden="true"></i>
                <div><b>Elaboración artesanal</b><span>Empanadas en packs x6 o x12.</span></div>
            </div>

        </div>
    </section>

    <section class="seccion">
        <h2 class="rubro">Cómo funciona 48·72</h2>
        <ol class="recorrido">
            <li>
                <span class="n">1</span>
                <span class="que"><b>Elegís de la carta</b><span>Y sacás lo que no te gusta.</span></span>
            </li>
            <li>
                <span class="n">2</span>
                <span class="que"><b>Dejás tus datos</b><span>Nombre, dirección y WhatsApp.</span></span>
            </li>
            @* la espera no lleva número: no es algo que hace el cliente *@
            <li class="fermenta">
                <span class="n">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                </span>
                <span class="que"><b>48 a 72 horas</b></span>
            </li>
            <li>
                <span class="n">3</span>
                <span class="que"><b>Te escribimos</b><span>Por WhatsApp, para coordinar la entrega.</span></span>
            </li>
            <li>
                <span class="n">4</span>
                <span class="que"><b>Te llevamos tu pedido</b><span>Sin apps de por medio.</span></span>
            </li>
        </ol>
    </section>

    @* Cuándo lo comés. La pantalla contaba cómo se hace y cómo se pide, pero
       nunca qué día llega; los «48 a 72 horas» del recorrido son de la masa, no
       del pedido. Va pegada al botón, que es donde se decide.

       Sin nombrar un día de corte a propósito: el pedido tiene que estar el
       miércoles o el jueves según cuánto fermente, y eso todavía no está fijo. *@
    <p class="franja">Pedís en la semana, lo recibís el finde.</p>

    <div class="cta-pie">
        <a class="cta" asp-controller="Tienda" asp-action="Carta">Armá tu pedido</a>
    </div>

</div>
