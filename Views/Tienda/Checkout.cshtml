@model f4872.ViewModels.CheckoutVm
@using System.Text.Json
@{
    ViewData["Title"] = "Tu pedido";
    Layout = "_Tienda";
}

<div class="tienda">

    <div class="barra-tope">
        <a asp-action="Carta">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"
                 stroke-linecap="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>
            La carta
        </a>
    </div>

    @* la lista y el total los escribe el navegador: el pedido está guardado ahí
       y todavía no existe en la base *@
    <main class="lista">
        <ul class="items" id="items"></ul>
        <dl class="total"><dt>Total</dt><i class="guia"></i><dd id="total">$0</dd></dl>

        @* La dirección va en un solo renglón. Lo que falte —piso, timbre— se
           arregla por WhatsApp, que es la conversación que va a haber igual *@
        <div class="datos">
            <div class="campo">
                <label for="nom">Tu nombre</label>
                <input id="nom" type="text" placeholder="Cómo te anotamos"
                       autocomplete="name" maxlength="60" />
            </div>
            <div class="campo">
                <label for="dir">Dirección</label>
                <input id="dir" type="text" placeholder="Calle y número"
                       autocomplete="street-address" maxlength="120" />
            </div>
            <div class="campo">
                <label for="wa">Tu WhatsApp</label>
                <input id="wa" type="tel" inputmode="tel" placeholder="11 5555 5555"
                       autocomplete="tel" maxlength="30" />
                <p class="frase">Te escribimos por acá para coordinar la entrega.</p>
            </div>
        </div>

        <div class="accion">
            @* lo que puede fallar al confirmar no es culpa de quien pide —algo
               se acabó, se cortó la conexión— así que el aviso va pegado al
               botón, que es lo que acaba de tocar. role=alert para que un lector
               de pantalla lo diga sin que haga falta ir a buscarlo *@
            <p class="aviso" id="aviso" role="alert" hidden></p>
            <button class="confirmar" type="button" id="confirmar" disabled>Realizar pedido</button>
        </div>
    </main>

</div>

@* la carta como diccionario, para traducir las claves guardadas. El
   serializador escapa < y > por defecto, así que un nombre con etiquetas
   adentro no puede cerrar este bloque *@
<script type="application/json" id="carta">
    @Html.Raw(JsonSerializer.Serialize(Model))
</script>

@section Scripts {
    <script src="~/js/checkout.js" asp-append-version="true"></script>
}
