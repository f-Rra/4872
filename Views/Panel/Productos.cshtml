@using f4872.Models
@model f4872.ViewModels.ProductosVm
@{
    ViewData["Title"] = "Productos";
    ViewData["Seccion"] = "productos";
    Layout = "_Marco";

    string Fam(Familia f) => f switch
    {
        Familia.Pizza => "Pizza",
        Familia.Focaccia => "Focaccia",
        _ => "Empanada"
    };

    // el título de cada grupo dice lo mismo que su chip de arriba
    string Titulo(Familia f) => f4872.ViewModels.ProductosVm.Chips.First(x => x.Clave == f.ToString()).Nombre;
}

<div class="cabecera">
    <span class="cab-titulo">
        <h1>Productos</h1>
        <span class="sub">@Model.Resumen</span>
    </span>

    <div class="filtros">
        @foreach (var (clave, nombre) in f4872.ViewModels.ProductosVm.Chips)
        {
            <a asp-action="Productos" asp-route-familia="@clave"
               aria-pressed="@((clave == Model.Familia).ToString().ToLowerInvariant())">@nombre</a>
        }
    </div>
</div>

<partial name="_Hecho" />

<div class="doble">

    @* El alta queda fija abajo aunque la lista scrollee, y abre la misma ficha
       en blanco: no hay una pantalla de alta distinta de la de edición. *@
    <div class="columna con-pie">
        <div class="rollo">
            @* Un grupo por tipo, en el orden en que ya viene la lista. El título
               sale solo con «Todo»: con un tipo elegido arriba repetiría el chip.
               Y con el tipo en el título, el renglón ya no lo dice: queda en una
               línea, nombre y precio.

               Delante del nombre, su lugar en la carta: la lista se lee como la
               va a ver el cliente. *@
            @foreach (var grupo in Model.Lista.GroupBy(x => x.Familia))
            {
                <section class="grupo-lista">
                    @if (Model.Familia == "todo")
                    {
                        <h2 class="cab-grupo">@Titulo(grupo.Key)<span class="cuantos">· @grupo.Count()</span></h2>
                    }
                    <ul class="en-una-linea">
                        @foreach (var (p, lugar) in grupo.Select((x, i) => (x, i + 1)))
                        {
                            <li class="@(!Model.EsNuevo && p.IdProducto == Model.Ficha.IdProducto ? "elegido" : null)">
                                <a asp-action="Productos" asp-route-familia="@Model.Familia" asp-route-producto="@p.IdProducto">
                                    <span class="izq">
                                        <span class="fila-p">
                                            <span class="n-lugar">@lugar</span>
                                            <span class="nom">@p.Nombre</span>
                                            @if (!p.Activo)
                                            {
                                                <span class="agotado">Agotado</span>
                                            }
                                            @if (p.Precio is decimal plata)
                                            {
                                                <span class="plata">@plata.ToString("C")</span>
                                            }
                                            else
                                            {
                                                <span class="plata packs-dos">
                                                    @string.Join(" / ", Model.Ficha.Packs.Select(x => x.Precio.ToString("C")))
                                                </span>
                                            }
                                        </span>
                                    </span>
                                </a>
                            </li>
                        }
                    </ul>
                </section>
            }
        </div>

        <a class="alta" asp-action="Productos" asp-route-familia="@Model.Familia" asp-route-nuevo="true"
           aria-pressed="@Model.EsNuevo.ToString().ToLowerInvariant()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                 stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>Producto nuevo
        </a>
    </div>

    @* Renglón etiquetado: etiqueta a la izquierda, valor a la derecha, un filete
       entre cada uno. Todo alineado en una sola columna y el ojo baja
       comparando. El costo es que los campos no parecen editables hasta que
       pasás el mouse; se aprende una vez. *@
    <div class="detalle">
        @* La ficha se cierra antes de la receta: los formularios de sumar y
           quitar ingredientes son formularios propios, y un formulario no puede
           ir adentro de otro. El botón de guardar los saltea con form="ficha",
           así el orden de la pantalla queda como en la maqueta. *@
        <form id="ficha" method="post" asp-action="GuardarProducto"
              asp-route-familia="@Model.Familia" asp-route-nuevo="@Model.EsNuevo">

            <input type="hidden" asp-for="Ficha.IdProducto" />

            @if (Model.EsNuevo)
            {
                <div class="det-tope"><h2>Producto nuevo</h2></div>
                <p class="det-meta">Se agrega a la carta apenas lo crees.</p>
            }
            else
            {
                <div class="det-tope">
                    <h2>@Model.Titulo</h2>
                    <span class="estado @(Model.ActivoGuardado ? "e-nuevo" : "e-entregado")">
                        @(Model.ActivoGuardado ? "En la carta" : "Agotado")
                    </span>
                </div>
                <p class="det-meta">@Model.Subtitulo</p>
            }

            @if (Model.Error is string error)
            {
                <p class="aviso" role="alert">@error</p>
            }

            <div class="renglones">

                <div class="reng">
                    <span class="et">Nombre</span>
                    <span class="va"><input asp-for="Ficha.Nombre" maxlength="60" autocomplete="off" /></span>
                </div>

                <div class="reng">
                    <span class="et">Tipo</span>
                    <span class="va">
                        <span class="chips-fam">
                            @foreach (var f in new[] { Familia.Pizza, Familia.Focaccia, Familia.Empanada })
                            {
                                <label class="chip-fam">
                                    <input type="radio" asp-for="Ficha.Familia" value="@f" />
                                    <span>@Fam(f)</span>
                                </label>
                            }
                        </span>
                    </span>
                </div>

                @* Debajo del tipo porque es dentro de él: el número se lee junto a
                   «de 7 pizzas». Las flechas son de otro formulario, como
                   «Modificable»: mueven un lugar y guardan solas, y no viajan
                   con el resto de la ficha. *@
                <div class="reng pos-reng">
                    <span class="et">Posición</span>
                    <span class="va">
                        @if (Model.EsNuevo)
                        {
                            <span class="nota-f nota-suelta">Entra al final de su tipo.</span>
                        }
                        else
                        {
                            <span class="lugar">@Model.Lugar</span>
                            <span class="cual">@Model.DeCuantos</span>
                            <span class="flechas">
                                <button class="mas" type="submit" form="mover" name="paso" value="-1"
                                        title="Subir un lugar" aria-label="Subir un lugar"
                                        disabled="@(Model.Lugar <= 1)">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"
                                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 15l6-6 6 6" /></svg>
                                </button>
                                <button class="mas" type="submit" form="mover" name="paso" value="1"
                                        title="Bajar un lugar" aria-label="Bajar un lugar"
                                        disabled="@(Model.Lugar >= Model.Cuantos)">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"
                                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
                                </button>
                            </span>
                        }
                    </span>
                </div>

                @* Los dos renglones van siempre y se esconde el que no toca: al
                   elegir «Empanada» en un producto nuevo, el precio tiene que
                   cambiar ahí mismo y no después de guardar. El servidor no
                   puede resolverlo solo, porque la familia que conoce es la
                   guardada; lo termina panel.js cuando se toca el chip.

                   Que viaje el renglón escondido no rompe nada: para una
                   empanada el precio suelto se descarta al guardar, y un precio
                   de pack en cero no pisa el que ya estaba. *@
                <div class="reng" data-precio="suelto" hidden="@Model.Ficha.SeCobraPorPack">
                    <span class="et">Precio</span>
                    @* el signo va afuera del campo: asi lo que se guarda sigue
                       siendo un numero y no hay que limpiarle nada al leerlo *@
                    <span class="va conplata">
                        <span class="signo">$</span>
                        <input asp-for="Ficha.Precio" asp-format="{0:0}" type="number" min="1" step="1" />
                    </span>
                </div>

                @for (var i = 0; i < Model.Ficha.Packs.Count; i++)
                {
                    var j = i;
                    <div class="reng" data-precio="pack" hidden="@(!Model.Ficha.SeCobraPorPack)">
                        @* con parentesis: pegado a la x, Razor lee el @@ como literal *@
                        <span class="et">Pack x@(Model.Ficha.Packs[j].Unidades)</span>
                        <span class="va conplata">
                            <input type="hidden" asp-for="Ficha.Packs[j].Unidades" />
                            <span class="signo">$</span>
                            @* sin decimales: ningun precio de la carta los tiene *@
                            <input asp-for="Ficha.Packs[j].Precio" asp-format="{0:0}" type="number" min="1" step="1" />
                        </span>
                    </div>
                }

            </div>
        </form>

        <p class="nota-f" data-precio="pack" hidden="@(!Model.Ficha.SeCobraPorPack)">Los dos precios valen para todos los gustos.</p>

        @* La receta entera acá: qué lleva, cuánto y qué se le puede sacar. Los
           tres juntos porque cuando cargás una pizza la pregunta es esa; ir a
           Ingredientes por el cuánto obliga a ir y volver por cada renglón.

           Las cantidades son campos de la ficha —se guardan con «Guardar
           cambios»— y por eso llevan form="ficha". Quitar y marcar modificable
           son formularios propios, que no pueden ir adentro de otro.

           Una empanada no lleva: todo lo suyo viene en el relleno, y el bloque
           se esconde con el tipo, como el precio. *@
        <div class="renglones sigue" data-no-empanada hidden="@Model.Ficha.SeCobraPorPack">
            <div class="reng alto receta-reng">
                <span class="et">Ingredientes</span>
                <span class="va">
                    @if (Model.EsNuevo)
                    {
                        <span class="nota-f nota-suelta">Se cargan después de crearlo.</span>
                    }
                    else
                    {
                        @* El renglón de arriba tiene tres estados y nunca se
                           mueve de lugar: el (+) en reposo, el buscador cuando
                           se abre, y el ingrediente elegido esperando el cuánto.

                           Va dibujado abierto y el script lo cierra al cargar:
                           sin JavaScript el buscador queda siempre a la vista y
                           la pantalla funciona igual, en dos viajes en vez de uno. *@
                        @* Se suma un ingrediente o una salsa, que es una receta de
                           Recetas: el renglón es el mismo y el buscador las
                           encuentra a las dos. *@
                        var suma = Model.Ficha.SalsasQueFaltan.Count > 0
                            ? "Sumar un ingrediente o una salsa"
                            : "Sumar un ingrediente";

                        <ul class="receta tope">
                            <li>
                                @* El botón que manda el formulario con Enter, escondido.
                                   Sin él manda el primero de la lista de abajo, y con las
                                   salsas al principio sumaría una sin que nadie la elija.
                                   Sin ningún botón elegido el servidor busca lo escrito. *@
                                <button type="submit" form="sumar-ingrediente" hidden tabindex="-1" aria-hidden="true"></button>

                                <button class="mas" type="button" data-abrir-ingrediente
                                        title="@suma" aria-label="@suma" hidden>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"
                                         stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                                </button>

                                @* el texto acompaña al (+) en reposo. Va escondido y
                                   el script lo muestra: sin JavaScript lo que se ve
                                   es el campo, que es lo que sirve *@
                                <button class="dice" type="button" data-abrir-ingrediente hidden>
                                    @suma
                                </button>

                                @if (Model.Ficha.Sumando is null)
                                {
                                    <input class="buscar-linea" type="text" name="nombre" form="sumar-ingrediente"
                                           data-buscar placeholder="Buscar…" autocomplete="off" />
                                }
                                else
                                {
                                    <span class="elegido">@Model.Ficha.Sumando.Nombre</span>
                                    <input type="hidden" name="nombre" form="sumar-ingrediente"
                                           value="@Model.Ficha.Sumando.Nombre" />
                                    <span class="rcaja">
                                        <input class="rc" type="text" name="cantidad" form="sumar-ingrediente"
                                               inputmode="decimal" placeholder="0" autofocus />
                                        <span class="ru">@Model.Ficha.Sumando.Unidad</span>
                                    </span>
                                }

                                <span class="hueco-ojo"></span><span class="hueco"></span><span class="hueco-mover" hidden></span><span class="rx"></span>
                            </li>
                        </ul>

                        @if (Model.Ficha.Sumando is null)
                        {
                            @* Lista propia y no un datalist: el del navegador se
                               dibuja con los colores del sistema operativo. Los
                               renglones son botones que mandan el formulario:
                               sin JavaScript eligen, con JavaScript completan. *@
                            <ul class="candidatos" data-candidatos>
                                @* Las salsas primero, y con su marca: el (+) suma de las
                                   dos cosas y se tienen que distinguir. Una salsa no
                                   espera cantidad: entra con una porción, directo. *@
                                @foreach (var s in Model.Ficha.SalsasQueFaltan)
                                {
                                    <li>
                                        <button type="submit" name="salsa" value="@s" form="sumar-ingrediente"
                                                asp-action="SumarSalsa" asp-route-id="@Model.Ficha.IdProducto"
                                                asp-route-familia="@Model.Familia"
                                                data-salsa="@s">@s<span class="marca-salsa">salsa</span></button>
                                    </li>
                                }
                                @foreach (var d in Model.Ficha.Disponibles)
                                {
                                    <li>
                                        <button type="submit" name="nombre" value="@d.Nombre"
                                                form="sumar-ingrediente"
                                                data-elegir="@d.Nombre" data-unidad="@d.Unidad">@d.Nombre</button>
                                    </li>
                                }
                                <li class="nada" hidden>
                                    No hay ninguno con ese nombre. Los ingredientes se dan de alta en <b>Ingredientes</b> y las salsas, en <b>Recetas</b>.
                                </li>
                            </ul>
                        }

                        @* En el orden de la carta, y se ordena arrastrando: el
                           orden en que quedan los renglones es el que se guarda
                           con «Guardar cambios», junto con las cantidades. *@
                        <ul class="receta" data-ordenable>
                            @for (var i = 0; i < Model.Ficha.Receta.Count; i++)
                            {
                                var j = i;
                                var r = Model.Ficha.Receta[j];

                                @* Una salsa es un renglón más de la lista: se ordena y
                                   se marca igual, pero lo que lleva son porciones, y sus
                                   formularios no chocan con los de un ingrediente. *@
                                var clave = r.EsSalsa ? "s" + r.IdSalsa : r.IdIngrediente.ToString();

                                <li class="@(r.Visible ? null : "oculto")">
                                    <span class="rn">@(r.Nombre)@if (r.EsSalsa)
                                    {<span class="marca-salsa">salsa</span>}</span>

                                    @if (r.EsSalsa)
                                    {
                                        <input type="hidden" form="ficha" asp-for="Ficha.Receta[j].IdSalsa" />
                                    }
                                    else
                                    {
                                        <input type="hidden" form="ficha" asp-for="Ficha.Receta[j].IdIngrediente" />
                                    }
                                    <input type="hidden" form="ficha" asp-for="Ficha.Receta[j].Nombre" />

                                    <span class="rcaja">
                                        @* sin ceros al final: 120 y no 120,000 *@
                                        <input class="rc" form="ficha" inputmode="decimal"
                                               asp-for="Ficha.Receta[j].Cantidad" asp-format="{0:0.##}" />
                                        <span class="ru">@r.Unidad</span>
                                    </span>

                                    @* El ojo: si la carta lo nombra. Va antes del Fijo o
                                       Modificable porque lo decide: lo que no se ve no se
                                       puede sacar, y esa pastilla se apaga. *@
                                    <button class="mas ojo" type="submit" form="ver-@clave"
                                            aria-pressed="@r.Visible.ToString().ToLowerInvariant()"
                                            title="@(r.Visible ? "Se ve en la carta: tocá para ocultarlo" : "No se ve en la carta: tocá para mostrarlo")"
                                            aria-label="@(r.Visible ? "Ocultar" : "Mostrar") @r.Nombre en la carta">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12ZM12 9.5a2.5 2.5 0 1 0 .01 0" />
                                            @if (!r.Visible)
                                            {
                                                <path d="M4 4l16 16" />
                                            }
                                        </svg>
                                    </button>

                                    <button class="saca" type="submit" form="modificable-@clave"
                                            aria-pressed="@r.Modificable.ToString().ToLowerInvariant()"
                                            disabled="@(!r.Visible)"
                                            title="@(!r.Visible ? "Lo que no se ve en la carta no se puede sacar" : r.Modificable ? "El cliente lo puede sacar" : "No se puede sacar")">
                                        @(r.Modificable ? "Modificable" : "Fijo")
                                    </button>

                                    @* De donde se agarra para cambiarlo de lugar. Sin
                                       JavaScript no hay cómo arrastrar, así que viene
                                       escondida y la muestra panel.js, junto con el
                                       hueco que le hace lugar en los otros renglones. *@
                                    <button class="manija" type="button" data-manija hidden
                                            title="Arrastrá para cambiarlo de lugar"
                                            aria-label="Cambiar de lugar @r.Nombre: arrastrá, o usá las flechas del teclado">
                                        <svg viewBox="0 0 10 16" fill="currentColor" aria-hidden="true">
                                            <circle cx="2.5" cy="3" r="1.4" /><circle cx="7.5" cy="3" r="1.4" />
                                            <circle cx="2.5" cy="8" r="1.4" /><circle cx="7.5" cy="8" r="1.4" />
                                            <circle cx="2.5" cy="13" r="1.4" /><circle cx="7.5" cy="13" r="1.4" />
                                        </svg>
                                    </button>

                                    <button class="rx" type="submit" form="quitar-@clave"
                                            title="Quitar" aria-label="Quitar @r.Nombre">×</button>
                                </li>
                            }
                        </ul>

                        @* Cuántos nombra la carta: como mucho cuatro, que es lo que entra en
                           una línea del teléfono. Los demás están en la receta por el costo. *@
                        @if (Model.Ficha.Receta.Count > 0)
                        {
                            <p class="nota-f cuenta-abajo">
                                Se ven @Model.Ficha.Receta.Count(x => x.Visible) de @f4872.Models.Producto.MaximoEnLaCarta en la carta.
                            </p>
                        }
                    }
                </span>
            </div>
        </div>

        @* Lo que le toca de masa a una pieza. Una pizza es un bollo, así que
           estos números están en la misma unidad que los de arriba: lo que lleva
           una. Van de lectura porque son derivados -la masa se carga entera- y
           porque la receta del bollo no es de este producto: se cambia en
           Recetas. *@
        @if (Model.Ficha.Base is f4872.ViewModels.RecetaPorPieza laBase)
        {
            <div class="renglones sigue" data-no-empanada>
                <div class="reng alto receta-reng">
                    <span class="et">Base</span>
                    <span class="va">
                        <partial name="_Receta" model="laBase" />
                    </span>
                </div>
            </div>
        }

        @* Las salsas que lleva, de lectura como la base. Cada una es una receta
           aparte, y por eso cada una lleva su nombre arriba: sin él, dos seguidas
           se leen como una sola. Las porciones y si se puede sacar se cambian en
           la lista de arriba, junto a los ingredientes. Un bloque por salsa, y
           ninguno si no lleva. *@
        @if (Model.Ficha.Salsas.Count > 0)
        {
            <div class="renglones sigue" data-no-empanada hidden="@Model.Ficha.SeCobraPorPack">
                <div class="reng alto receta-reng">
                    <span class="et">Salsas</span>
                    <span class="va">
                        @foreach (var s in Model.Ficha.Salsas)
                        {
                            <partial name="_Receta" model="s" />
                        }
                    </span>
                </div>
            </div>
        }

        @* El relleno de una empanada: todo lo que lleva, tapas incluidas. Se
           elige como la salsa y se ve abierto, lo de una empanada. No hay «sin
           relleno»: una empanada sin relleno no es una empanada. *@
        <div class="renglones sigue" data-empanada data-elige hidden="@(!Model.Ficha.SeCobraPorPack)">
            <div class="reng alto receta-reng">
                <span class="et">Relleno</span>
                <span class="va">
                    @if (Model.Ficha.Rellenos.Count == 0)
                    {
                        <span class="nota-f nota-suelta">Todavía no hay rellenos: se cargan en Recetas.</span>
                    }
                    else
                    {
                        <span class="chips-fam">
                            @foreach (var r in Model.Ficha.Rellenos)
                            {
                                <label class="chip-fam">
                                    <input type="radio" name="Ficha.IdRelleno" value="@r.IdReceta" form="ficha"
                                           checked="@(Model.Ficha.IdRelleno == r.IdReceta)" />
                                    <span>@r.Nombre</span>
                                </label>
                            }
                        </span>
                        @foreach (var r in Model.Ficha.Rellenos)
                        {
                            <partial name="_PorPieza" model="r"
                                     view-data='new ViewDataDictionary(ViewData) { ["Escondida"] = Model.Ficha.IdRelleno != r.IdReceta }' />
                        }
                    }
                </span>
            </div>
        </div>

        @if (!Model.EsNuevo)
        {
            <form id="mover" method="post" asp-action="Mover"
                  asp-route-id="@Model.Ficha.IdProducto" asp-route-familia="@Model.Familia"></form>

            <form id="sumar-ingrediente" method="post" asp-action="SumarIngrediente"
                  asp-route-id="@Model.Ficha.IdProducto" asp-route-familia="@Model.Familia"></form>

            @foreach (var r in Model.Ficha.Receta)
            {
                if (r.EsSalsa)
                {
                    <form id="quitar-s@(r.IdSalsa)" method="post" asp-action="QuitarSalsa"
                          asp-route-id="@Model.Ficha.IdProducto" asp-route-idReceta="@r.IdSalsa"
                          asp-route-familia="@Model.Familia"></form>

                    <form id="ver-s@(r.IdSalsa)" method="post" asp-action="VisibleSalsa"
                          asp-route-id="@Model.Ficha.IdProducto" asp-route-idReceta="@r.IdSalsa"
                          asp-route-familia="@Model.Familia"></form>

                    <form id="modificable-s@(r.IdSalsa)" method="post" asp-action="ModificableSalsa"
                          asp-route-id="@Model.Ficha.IdProducto" asp-route-idReceta="@r.IdSalsa"
                          asp-route-familia="@Model.Familia"></form>
                }
                else
                {
                    <form id="quitar-@r.IdIngrediente" method="post" asp-action="QuitarIngrediente"
                          asp-route-id="@Model.Ficha.IdProducto" asp-route-idIngrediente="@r.IdIngrediente"
                          asp-route-familia="@Model.Familia"></form>

                    <form id="ver-@r.IdIngrediente" method="post" asp-action="Visible"
                          asp-route-id="@Model.Ficha.IdProducto" asp-route-idIngrediente="@r.IdIngrediente"
                          asp-route-familia="@Model.Familia"></form>

                    <form id="modificable-@r.IdIngrediente" method="post" asp-action="Modificable"
                          asp-route-id="@Model.Ficha.IdProducto" asp-route-idIngrediente="@r.IdIngrediente"
                          asp-route-familia="@Model.Familia"></form>
                }
            }
        }

        @* Los dos en la misma fila y del ancho de su texto: guardar es lo que se
           toca siempre, pero marcar agotado no es una acción de otra pantalla
           como para mandarla a un renglón aparte. *@
        <div class="acciones en-fila">
            <button class="btn" type="submit" form="ficha">@(Model.EsNuevo ? "Crear producto" : "Guardar cambios")</button>

            @if (!Model.EsNuevo)
            {
                @* No hay botón de borrar: un producto puede estar nombrado en
                   pedidos viejos, y borrarlo dejaría el historial hablando de
                   algo que no existe. Marcarlo agotado lo saca de la carta y lo
                   deja vivo acá. *@
                <form method="post" asp-action="Agotar"
                      asp-route-id="@Model.Ficha.IdProducto" asp-route-familia="@Model.Familia">
                    <button class="btn flaco" type="submit">
                        @(Model.ActivoGuardado ? "Marcar agotado" : "Volver a la carta")
                    </button>
                </form>
            }
        </div>

    </div>

</div>
