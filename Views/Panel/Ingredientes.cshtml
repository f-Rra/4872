@model f4872.ViewModels.IngredientesVm
@{
    ViewData["Title"] = "Ingredientes";
    ViewData["Seccion"] = "ingredientes";
    Layout = "_Marco";
}

<div class="cabecera">
    <span class="cab-titulo">
        <h1>Ingredientes</h1>
        <span class="sub">@Model.EnRecetas en las recetas</span>
    </span>
</div>

@* Para cuántos pedidos es esta cuenta. Va arriba de todo porque es lo que le da
   sentido a las tres columnas: no es el inventario, es lo que hace falta para
   lo que hay pedido. *@
<div class="banda">
    <b>Para los @Model.Pedidos @(Model.Pedidos == 1 ? "pedido sin entregar" : "pedidos sin entregar")</b>
    <span class="aparte">
        @(Model.Faltantes == 0
            ? "alcanza con lo que hay"
            : $"hay que comprar {Model.Faltantes} {(Model.Faltantes == 1 ? "ingrediente" : "ingredientes")}")
    </span>
</div>

@* Stock · Necesito · Falta, en el orden de la resta. El stock se edita en el
   renglón; las otras dos salen solas de los pedidos. La última columna es la
   lista: lo que hay que ir a buscar. *@
<div class="rollo-ing">
    <table class="grilla">
        <thead>
            <tr>
                <th>Ingrediente</th>
                <th class="g-num">Stock</th>
                <th class="g-num">Necesito</th>
                <th class="g-num">Falta</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Lista.Count == 0)
            {
                <tr>
                    <td colspan="4" class="sinCargar">
                        Ningún ingrediente entra en los pedidos que hay. Probá «Ver todos».
                    </td>
                </tr>
            }

            @foreach (var i in Model.Lista)
            {
                <tr>
                    <td class="g-nom">
                        @* el nombre abre la ficha. Es un enlace y no un botón:
                           abrirla no cambia nada, y así se puede compartir y
                           volver con el botón de atrás *@
                        <a class="abre" asp-action="Ingredientes"
                           asp-route-todos="@Model.Todos" asp-route-ingrediente="@i.IdIngrediente">@i.Nombre</a>
                        <span class="bajo">@i.Donde</span>
                    </td>

                    <td class="g-num">
                        @* un formulario por renglón: se guarda solo el número que
                           se tocó y no la tabla entera *@
                        <form method="post" asp-action="Stock"
                              asp-route-id="@i.IdIngrediente" asp-route-todos="@Model.Todos">
                            @* el campo lleva la unidad escrita —«11 kg», «24 u»—
                               y crece con lo que diga. Con piso: casi todos los
                               valores entran en seis caracteres y así la columna
                               de pastillas queda pareja, sin dentar el borde
                               izquierdo por un «0 u» *@
                            <input name="stock" type="text" inputmode="decimal" data-medida
                                   value="@i.Stock" style="width:@(Math.Max(6, i.Stock.Length))ch"
                                   aria-label="Stock de @i.Nombre" />
                        </form>
                    </td>

                    <td class="g-num g-flojo">@i.Necesito</td>

                    <td class="g-fin g-num">
                        @* el agua y la masa madre no se compran, así que nunca
                           faltan. No hace falta decir por qué: son dos de
                           cuarenta y el resto se compra todo *@
                        @if (i.HayQueComprar)
                        {
                            <b class="urge">@i.Falta</b>
                        }
                        else
                        {
                            <span class="sinCargar">—</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="pie-tabla">
    @* el alta entra en la tanda que sigue, con la ficha del ingrediente *@
    <span class="cuantos">
        @Model.Cuantos de @Model.EnTotal ingredientes
        <a asp-action="Ingredientes" asp-route-todos="@(!Model.Todos)">
            @(Model.Todos ? "Solo los del finde" : "Ver todos")
        </a>
    </span>
</div>

@* La ficha, encima de la grilla. Se dibuja en el servidor cuando viene un
   ingrediente en la dirección, así que abre y cierra sin JavaScript. *@
@if (Model.Ficha is f4872.ViewModels.FichaIngrediente f)
{
    <div class="telon">
        @* el telón es un enlace: hacer clic afuera cierra, que es lo que
           espera cualquiera, y sin depender de que corra un script *@
        <a class="tapa" asp-action="Ingredientes" asp-route-todos="@Model.Todos"
           aria-label="Cerrar"></a>

        <div class="modal" role="dialog" aria-label="@f.Titulo">
            <div class="det-tope"><h2>@f.Titulo</h2></div>
            <p class="det-meta">@f.Donde</p>

            @if (Model.Error is string error)
            {
                <p class="aviso" role="alert">@error</p>
            }

            <form method="post" asp-action="GuardarIngrediente" asp-route-todos="@Model.Todos">
                <input type="hidden" asp-for="Ficha!.IdIngrediente" />

                <div class="renglones">

                    <div class="reng">
                        <span class="et">Nombre</span>
                        <span class="va">
                            <input asp-for="Ficha!.Nombre" maxlength="60" autocomplete="off" />
                        </span>
                    </div>

                    <div class="reng">
                        <span class="et">Se mide en</span>
                        <span class="va">
                            <span class="chips-fam">
                                @foreach (var (valor, nombre) in f4872.ViewModels.FichaIngrediente.Medidas)
                                {
                                    <label class="chip-fam">
                                        <input type="radio" asp-for="Ficha!.Unidad" value="@valor" />
                                        <span>@nombre</span>
                                    </label>
                                }
                            </span>
                        </span>
                    </div>

                    @* Los dos números de la compra van en pastilla: son lo único
                       que se escribe a mano acá, y en el panel el borde redondo
                       es lo que avisa que algo se toca. *@
                    @if (!f.Libre)
                    {
                        <div class="reng">
                            <span class="et">De a</span>
                            <span class="va">
                                <span class="pastilla">
                                    @* adentro y a la izquierda, como el $ del precio:
                                       no se escribe, sale de la medida de arriba. El
                                       script la cambia al tocar otro chip *@
                                    <span class="signo" data-uni>@f.UnidadCorta</span>
                                    <input asp-for="Ficha!.Bulto" type="text" inputmode="decimal"
                                           autocomplete="off" placeholder="0" />
                                </span>
                            </span>
                        </div>

                        <div class="reng">
                            <span class="et">Precio</span>
                            <span class="va">
                                <span class="pastilla">
                                    <span class="signo">$</span>
                                    <input asp-for="Ficha!.Precio" asp-format="{0:0}"
                                           type="number" min="1" step="1" />
                                </span>
                            </span>
                        </div>
                    }

                </div>

                @* De donde sale el número de la grilla. Es de lectura: las
                   cantidades se cargan en la receta de cada producto, que es
                   donde estás pensando en ese producto. *@
                @if (f.Desglose.Count > 0)
                {
                    <div class="reparto">
                        @foreach (var d in f.Desglose)
                        {
                            <div class="fila">
                                <span class="qn">
                                    @d.Donde
                                    @if (d.Rinde is string cada)
                                    {
                                        <em class="rinde">@cada</em>
                                    }
                                </span>
                                <span class="cu">@d.Cuanto</span>
                                <span class="sale">@d.Sale</span>
                            </div>
                        }

                        <div class="fila total">
                            <span class="qn">Hace falta</span>
                            <span class="sale">@f.HaceFalta</span>
                        </div>
                    </div>
                }

                @if (f.Libre)
                {
                    <p class="nota-f">El agua y la masa madre no se compran: no entran en la lista ni en los costos.</p>
                }

                <div class="acciones en-fila">
                    <button class="btn" type="submit">Guardar cambios</button>
                    <a class="btn flaco" asp-action="Ingredientes" asp-route-todos="@Model.Todos">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
}
