@model f4872.ViewModels.InicioVm
@{
    ViewData["Title"] = "Inicio";
    ViewData["Seccion"] = "inicio";
    Layout = "_Marco";
}

<div class="cabecera">
    <span class="cab-titulo">
        <h1>Inicio</h1>
        <span class="sub">@Model.SinEntregar @(Model.SinEntregar == 1 ? "pedido sin entregar" : "pedidos sin entregar")</span>
    </span>

    @* El interruptor va por formulario y no por JavaScript: es un botón que
       cambia algo en la base, y así funciona igual si el script no cargó.
       Vuelve acá mismo, que es donde se ve el efecto. *@
    <form class="llave-tienda" method="post" asp-action="Llave">
        <span class="et-t">La tienda</span>
        <button class="llave" type="submit" aria-pressed="@Model.Abierta.ToString().ToLowerInvariant()">
            @(Model.Abierta ? "Abierta" : "Cerrada")
        </button>
    </form>
</div>

@if (!Model.Abierta)
{
    <div class="banda cerrada">
        <b>La tienda está cerrada</b>
        <span>· no entran pedidos nuevos hasta que la abras</span>
    </div>
}

<div class="ini">

    @* Cinco tarjetas y nada más. Salieron de un catálogo de veintiséis cifras
       que el panel sabe calcular; estas son las que hoy salen solo de los
       pedidos. Las otras tres que trae la maqueta —Falta comprar, Producción y
       Costo— necesitan las recetas y el stock. *@
    <dl class="tarjetas-ini">
        @foreach (var c in Model.Cifras)
        {
            <div class="card">
                <dt>@c.Titulo</dt>
                <dd>@c.Valor</dd>
                <span class="n">@c.Nota</span>
            </div>
        }
    </dl>

    @* Hornear y Comprar, las dos listas de abajo, entran en las tandas que siguen *@
    <p class="porAhora">Hornear y Comprar entran en las tandas que siguen.</p>
</div>
