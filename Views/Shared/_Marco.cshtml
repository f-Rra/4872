@using Microsoft.AspNetCore.Html
@model f4872.ViewModels.PanelVm
@{
    Layout = "_Panel";
    var seccion = ViewData["Seccion"] as string;
}

@* La barra lateral y el cuerpo. Todas las pantallas del panel van adentro de
   esto; la entrada no, que usa _Panel pelado.

   Las líneas van rectas y no con el trazo a mano de la tienda, tal como está
   maquetado: la tienda es el mostrador y el panel es la herramienta. *@
<div class="panel">

    <aside class="lateral">
        <div class="marca"><img src="~/img/logo.png" alt="48·72" width="240" height="240" /></div>

        <nav aria-label="Secciones">
            @* Las cinco que faltan van apagadas en vez de escondidas: así se ve
               de una qué panel va a haber, y cada tanda enciende una. *@
            @foreach (var (id, nombre, dibujo) in Secciones)
            {
                var globo = id == "pedidos" && Model.SinEntregar > 0
                    ? new HtmlString($"<span class=\"globo\">{Model.SinEntregar}</span>")
                    : HtmlString.Empty;

                if (id == "inicio")
                {
                    <a asp-action="Index" aria-current="@(id == seccion ? "page" : null)">@Icono(dibujo)@nombre@globo</a>
                }
                else if (id == "pedidos")
                {
                    <a asp-action="Pedidos" aria-current="@(id == seccion ? "page" : null)">@Icono(dibujo)@nombre@globo</a>
                }
                else if (id == "produccion")
                {
                    <a asp-action="Produccion" aria-current="@(id == seccion ? "page" : null)">@Icono(dibujo)@nombre@globo</a>
                }
                else
                {
                    <span class="porVenir" title="Todavía no está hecha">@Icono(dibujo)@nombre@globo</span>
                }
            }
        </nav>

        @* el estado se ve desde cualquier pantalla. Es el error caro de este
           diseño: dejarla cerrada un martes sin darse cuenta *@
        <p class="pie @(Model.Abierta ? null : "pie-alerta")">
            @if (Model.Abierta)
            {
                <text>Tienda abierta</text>
            }
            else
            {
                <b>Tienda cerrada</b>
            }
        </p>
    </aside>

    <main class="obra">
        @RenderBody()
    </main>

</div>

@functions {
    static readonly (string Id, string Nombre, string Dibujo)[] Secciones =
    [
        ("inicio", "Inicio", "M3 10.5 12 3l9 7.5M5.5 9.5V20h13V9.5M9.5 20v-5.5h5V20"),
        ("pedidos", "Pedidos", "M5.5 3h13v18l-2.2-1.6L14 21l-2-1.6L10 21l-2.3-1.6L5.5 21ZM9 8h6M9 12h6"),
        ("produccion", "Producción", "M3.5 6.5h17v13h-17zM3.5 11h17M7 8.5h.01M10 8.5h.01M8 15h8"),
        ("productos", "Productos", "M12 3.5a8.5 8.5 0 1 0 .01 0M12 7a5 5 0 1 0 .01 0"),
        ("ingredientes", "Ingredientes", "M8 3h8l-1 3H9ZM9 6h6l1.5 4v9a2 2 0 0 1-2 2h-5a2 2 0 0 1-2-2v-9ZM8 13h8"),
        ("costos", "Costos", "M3.5 12.2 12.2 3.5H20.5v8.3l-8.7 8.7Z")
    ];

    static IHtmlContent Icono(string dibujo) => new HtmlString(
        $"""<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="{dibujo}" /></svg>""");
}
