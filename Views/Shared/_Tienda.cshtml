@*
    El marco del comprador. No carga Bootstrap a propósito: el diseño de la
    tienda está medido al píxel y el reboot de Bootstrap pelearía con él.
*@
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* el inicio no pone título y queda solo la marca, para no repetirla dos veces *@
    <title>@(ViewData["Title"] is null ? "48·72" : ViewData["Title"] + " · 48·72")</title>
    @*
        La tarjeta que WhatsApp, Telegram y el resto dibujan cuando alguien comparte el link: imagen,
        título y descripción. Es una sola para toda la tienda y no cambia con la pantalla.
        La imagen lleva la dirección entera, con https y dominio, porque la baja el servidor de la app
        que muestra el link y no el navegador de quien lo recibe: con /img/x.png no sabría de dónde.
        La dirección sale del propio pedido, así que en producción es 4872.com.ar y en la máquina de
        uno, localhost.
        Las apps guardan la tarjeta y la imagen: si se cambia el dibujo, hay que cambiarle el nombre
        al archivo, o siguen mostrando el viejo.
        Los textos van escritos acá y no en una variable: así salen tal cual y no con las tildes
        convertidas en códigos.
    *@
    @{ var origen = Context.Request.Scheme + "://" + Context.Request.Host; }
    <meta name="description" content="Pedís en la semana, lo recibís el finde." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="48·72" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content="48·72 · Pizzas, focaccias y empanadas" />
    <meta property="og:description" content="Pedís en la semana, lo recibís el finde." />
    <meta property="og:url" content="@(origen + Context.Request.PathBase + Context.Request.Path)" />
    <meta property="og:image" content="@(origen + Url.Content("~/img/vista-previa.png"))" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="El logo de 48·72 junto a los dibujos de una pizza, una empanada y una focaccia" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@@400;500;600;700;800&family=Bowlby+One&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tienda.css" asp-append-version="true" />
</head>
@* la confirmación pinta la ventana entera de verde, no solo la columna *@
<body class="@ViewData["Cuerpo"]">
    @RenderBody()
    <script src="~/js/tienda.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
