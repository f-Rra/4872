@model ErrorViewModel
@{
    ViewData["Title"] = "Algo salió mal";
}

@* Sin diseño propio y sin explicar nada: el que llega acá quiere volver a
   intentar, no leer. La referencia va por si hay que buscarla en el registro. *@
<h1>Algo salió mal</h1>
<p>Probá de nuevo en un rato.</p>

@if (Model.ShowRequestId)
{
    <p><code>@Model.RequestId</code></p>
}
